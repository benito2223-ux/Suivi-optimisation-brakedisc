N155 G1 Z=-1.5-1 F0.25 M870 ;AG2.1 ALESAGE
N160 ;;M890 ;// MONT. DESACTIVER SURVEILLANCE OUTIL
N165 G0 X-70.5
N170 WHEN TRUE DO $R922=0
N175 G0 Z100 G97 S1746

;------------------------------------------------
