N337 G4S2
N340 G1 X219.0 Z37.00 F0.35 H5002 ;F0.35   AG4.1 PISTE FINITION
N345 ;;M890 ;// MONT. DESACTIVER SURVEILLANCE OUTIL 
N350 STOPRE
N355 CR_BD_THICKNESS=CR_BD_THICKNESS+CR_BD_OPEN
N360 E_STRADDLE(69,1)
N365 G0 Z37.50 G97 S50 H5010 ;MARCHE SOUFFLAGE EXT MANDRIN
N370 M5
N375 G0 G95 S80 M3 X378
N380 WHEN TRUE DO $R922=0

;POSITIONS SOUFFLAGE EN ORIGINE MACHINE AXE Z
